# Copy to .env and adapt:  cp .env.example .env  &&  set -a && source .env && set +a
# The same code runs locally (MinIO) and on Onyxia: only these variables change.

# ---------- Local (MinIO from docker-compose.yml) ----------
DATA_ROOT=s3://bigdata-project
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
# pip-installed PySpark has no S3A connector: download the one matching its Hadoop (3.4.2)
HADOOP_AWS_PACKAGE=org.apache.hadoop:hadoop-aws:3.4.2

# ---------- Onyxia (vscode-pyspark service) ----------
# DATA_ROOT=s3://$KUBERNETES_NAMESPACE/bigdata_project
# S3_ENDPOINT_URL=$(aws configure get endpoint_url --profile default || echo "https://$AWS_S3_ENDPOINT")
# Credentials: run the script of "Mon compte > Connexion au stockage" (temporary credentials)
# HADOOP_AWS_PACKAGE=        # leave empty: hadoop-aws is already in $SPARK_HOME/jars

# ---------- Without any S3 (quick offline test) ----------
# DATA_ROOT=./data_lake

# ---------- Pipeline options ----------
# 1 = silver layer written as an Iceberg table (needs Maven Central access), 0 = plain Parquet
USE_ICEBERG=1
ICEBERG_PACKAGE=org.apache.iceberg:iceberg-spark-runtime-4.1_2.13:1.11.0
# Seasons downloaded and processed (keep raw total < 5 MB, see src/01_download.sh)
SEASONS="2021 2022 2023 2024 2025"
